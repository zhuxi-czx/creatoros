// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  FULL
  ONGOING
  ENDED
  CANCELLED
}

enum SignupStatus {
  CONFIRMED
  CANCELLED
}

enum OrderStatus {
  PENDING    // 已下单待支付
  PAID       // 支付成功
  CLOSED     // 超时/主动关单
  REFUNDING  // 退款中（本期不实现，占位）
  REFUNDED   // 已退款（本期不实现，占位）
}

model User {
  id         String     @id @default(cuid())
  uid        Int        @unique @default(autoincrement()) // 后台运营用的短数字编号
  openId     String     @unique
  unionId    String?
  nickname   String?
  avatarUrl  String?
  city       String?
  bio        String?
  gender     Int?
  mbti       String?
  zodiac     String?
  generation String?
  phone      String?
  role       Role       @default(USER)
  status     UserStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  signups Signup[]
  orders  Order[]
}

model Venue {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  description String?
  coverUrl    String?
  imageUrls   String[] @default([])
  autoplay    Boolean  @default(true)
  interval    Int      @default(3000)
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events Event[]
}

model Event {
  id          String      @id @default(cuid())
  title       String
  description String?
  highlights  String?
  schedule    String?
  notes       String?
  coverUrl    String?
  imageUrls   String[]    @default([])
  autoplay    Boolean     @default(true)
  interval    Int         @default(3000)
  date        DateTime
  venueId     String
  hostName    String?
  maxCapacity Int
  price       Int         @default(0)
  status      EventStatus @default(DRAFT)
  featured    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  venue   Venue    @relation(fields: [venueId], references: [id])
  signups Signup[]
  orders  Order[]

  @@index([status])
  @@index([featured])
}

model Signup {
  id        String      @id @default(cuid())
  userId    String
  eventId   String
  status    SignupStatus @default(CONFIRMED)
  orderId   String?     @unique   // 付费报名关联订单；免费报名为 null
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user  User   @relation(fields: [userId], references: [id])
  event Event  @relation(fields: [eventId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([userId])
}

model Order {
  id            String      @id @default(cuid())
  outTradeNo    String      @unique          // 商户订单号
  userId        String
  eventId       String
  amount        Int                          // 支付金额（分），下单时锁定
  status        OrderStatus @default(PENDING)
  transactionId String?                      // 微信支付订单号（回调返回）
  prepayId      String?                      // 预支付会话标识
  refundNo      String?     @unique          // 商户退款单号（退款时生成）
  refundedAt    DateTime?                    // 退款完成时间
  expiresAt     DateTime                     // 超时时间（下单 + 15min），过期不再占名额
  paidAt        DateTime?
  closedAt      DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  event  Event   @relation(fields: [eventId], references: [id])
  signup Signup?

  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@index([status, expiresAt])
}

model Banner {
  id            String   @id @default(cuid())
  title         String
  subtitle      String?
  imageUrls     String[] @default([])
  autoplay      Boolean  @default(true)
  interval      Int      @default(3000)
  sortOrder     Int      @default(0)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([enabled])
}
